{
  "name": "myhondaplus-vehicle-card",
  "version": "0.5.1",
  "description": "A polished Lovelace vehicle card for the unofficial My Honda+ Home Assistant integration",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Danieldiazi/myhondaplus-vehicle-card.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check package.json tsconfig.json vite.config.ts src/*.ts tests/**/*.ts",
    "test": "vitest run",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^17.8.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  }
}
